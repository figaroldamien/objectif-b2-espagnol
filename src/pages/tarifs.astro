---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FAQList from "@/components/FAQList.astro";
import { siteConfig } from "@/lib/site";
import { faqSchema } from "@/lib/schema";
const faqs = [{"question": "Le tarif est-il le m\u00eame si je n\u2019ai pas encore le niveau B2 ?", "answer": "Oui. Le cours individuel co\u00fbte 25 \u20ac pour 60 minutes, que vous souhaitiez consolider votre espagnol, progresser vers le B2 ou pr\u00e9parer les \u00e9preuves du DELE. Le contenu s\u2019adapte \u00e0 vos besoins."}, {"question": "L\u2019entretien d\u00e9couverte est-il obligatoire ?", "answer": "Non. L\u2019entretien d\u00e9couverte de 15 minutes est gratuit, facultatif et sans engagement. Vous pouvez me contacter directement par e-mail, par t\u00e9l\u00e9phone ou sur WhatsApp pour poser vos questions, choisir votre formule et fixer le premier cours."}, {"question": "Quelle est la diff\u00e9rence entre l\u2019entretien gratuit et le premier cours ?", "answer": "L\u2019entretien d\u00e9couverte, si vous choisissez de le r\u00e9server, permet de parler de votre projet et du fonctionnement des cours. Il dure 15 minutes et ne comprend pas d\u2019\u00e9valuation d\u00e9taill\u00e9e. Le premier cours est une s\u00e9ance de travail payante de 60 minutes. Nous r\u00e9alisons des activit\u00e9s cibl\u00e9es pour pr\u00e9ciser vos priorit\u00e9s et commencer \u00e0 travailler. Si vous choisissez le forfait, cette s\u00e9ance est comprise dans les cinq cours."}, {"question": "Quel est l\u2019avantage du forfait par rapport aux cours \u00e0 l\u2019unit\u00e9 ?", "answer": "Le forfait permet de construire un parcours sur cinq s\u00e9ances, avec des objectifs d\u00e9finis ensemble, une progression adapt\u00e9e \u00e0 vos difficult\u00e9s et un bilan \u00e0 la fin pour faire le point sur vos avanc\u00e9es. Vous n\u2019avez pas besoin de fixer tous les rendez-vous \u00e0 l\u2019avance : nous convenons du prochain cr\u00e9neau \u00e0 la fin de chaque cours, selon nos disponibilit\u00e9s. Le prix par s\u00e9ance reste le m\u00eame : 25 \u20ac. Le forfait privil\u00e9gie la continuit\u00e9 du travail, tandis que le cours \u00e0 l\u2019unit\u00e9 convient pour d\u00e9couvrir ma m\u00e9thode ou r\u00e9pondre \u00e0 un besoin ponctuel."}, {"question": "Dois-je m\u2019engager sur plusieurs forfaits ?", "answer": "Non. Vous pouvez commencer par un seul forfait. \u00c0 la fin des cinq s\u00e9ances, nous faisons le point et vous d\u00e9cidez si vous souhaitez poursuivre, selon vos besoins et nos disponibilit\u00e9s."}, {"question": "Comment travaille-t-on les productions \u00e9crites ?", "answer": "Vous pouvez r\u00e9aliser des activit\u00e9s \u00e9crites entre les s\u00e9ances, puis nous les reprenons ensemble pendant les cours. Nous analysons les erreurs, travaillons les reformulations et identifions les points \u00e0 am\u00e9liorer. Les corrections d\u00e9taill\u00e9es sont r\u00e9alis\u00e9es pendant le temps de cours."}, {"question": "Comment sont fix\u00e9s les rendez-vous ?", "answer": "Nous fixons le premier rendez-vous ensemble. Ensuite, \u00e0 la fin de chaque s\u00e9ance, nous convenons de la date et de l\u2019heure du prochain cours, selon nos disponibilit\u00e9s."}, {"question": "Combien de temps ai-je pour utiliser le forfait ?", "answer": "Les cinq cours sont \u00e0 utiliser dans les huit semaines suivant la premi\u00e8re s\u00e9ance. Nous tenons compte de ce d\u00e9lai pour organiser les rendez-vous."}, {"question": "Puis-je d\u00e9placer un cours ?", "answer": "Oui, en me pr\u00e9venant au moins 24 heures avant l\u2019horaire pr\u00e9vu. Nous cherchons alors un autre cr\u00e9neau selon nos disponibilit\u00e9s."}, {"question": "Comment se passe le paiement ?", "answer": "Le paiement s\u2019effectue par virement bancaire. Pour les cours \u00e0 l\u2019unit\u00e9, chaque s\u00e9ance est \u00e0 r\u00e9gler \u00e0 l\u2019avance au tarif de 25 \u20ac. Le forfait est \u00e0 r\u00e9gler en une seule fois, soit 125 \u20ac, avant sa premi\u00e8re s\u00e9ance. Je vous transmets les coordonn\u00e9es bancaires apr\u00e8s confirmation du premier rendez-vous. L\u2019entretien d\u00e9couverte de 15 minutes, si vous souhaitez en b\u00e9n\u00e9ficier, est gratuit, facultatif et sans engagement."}, {"question": "Les frais d\u2019inscription au DELE sont-ils inclus ?", "answer": "Non. Les tarifs concernent uniquement les cours et l\u2019accompagnement pr\u00e9sent\u00e9s sur cette page. L\u2019inscription et les frais d\u2019examen sont \u00e0 r\u00e9gler s\u00e9par\u00e9ment aupr\u00e8s d\u2019un centre d\u2019examen."}];
---
<BaseLayout title="Tarifs des cours d'espagnol | Objectif B2 Espagnol" description="Cours individuels en ligne : 25 euros la seance de 60 minutes ou 125 euros les cinq cours. Entretien gratuit de 15 minutes facultatif." pathname="/tarifs" schema={faqSchema(faqs)}>
<section class="section-gap pb-8"><div class="container-shell max-w-5xl space-y-6"><p class="eyebrow">Tarifs</p>
<h1 class="text-4xl sm:text-5xl lg:text-6xl">Cours d’espagnol et préparation au DELE B2 : tarifs</h1><p class="text-2xl font-bold">Avancez vers votre objectif, à votre rythme</p><p class="leading-8 text-ink/75">Vous souhaitez préparer le DELE B2 ou renforcer votre espagnol avant de vous lancer ? Je vous accompagne avec des cours individuels adaptés à votre niveau, à vos besoins et à vos disponibilités.</p><p class="leading-8 text-ink/75">Vous pouvez commencer même si vous n’avez pas encore le niveau B2 ou de date d’examen prévue.</p><a href="#formules" class="btn-primary">Voir les formules</a></div></section><section class="scroll-mt-48 py-8"><div class="container-shell max-w-5xl"><div class="surface-card space-y-5 p-6 sm:p-10"><h2 class="text-3xl sm:text-4xl">Un accompagnement adapté à votre situation</h2><h3 class="pt-4 text-2xl">Consolider votre espagnol pour progresser vers le B2</h3><p class="leading-8 text-ink/75">Vous avez besoin de renforcer vos bases et de gagner en aisance ? Nous travaillons progressivement le vocabulaire, la grammaire, la compréhension et l’expression orale et écrite.</p><p class="leading-8 text-ink/75">L’objectif est de consolider vos acquis et de développer les compétences nécessaires pour avancer vers le niveau B2.</p><h3 class="pt-4 text-2xl">Préparer les épreuves du DELE B2</h3><p class="leading-8 text-ink/75">Si votre niveau le permet, nous travaillons les tâches de l’examen, les stratégies pour les aborder et vos difficultés particulières.</p><p class="leading-8 text-ink/75">Vous vous entraînez à votre rythme, avec des explications et des retours pour comprendre vos erreurs et améliorer vos productions.</p></div></div></section><section class="scroll-mt-48 py-8"><div class="container-shell max-w-5xl"><div class="surface-card space-y-5 p-6 sm:p-10"><h2 class="text-3xl sm:text-4xl">Un entretien découverte gratuit, si vous le souhaitez</h2><p class="leading-8 text-ink/75">Vous souhaitez parler de votre projet avant de choisir votre formule ? Je vous propose un entretien découverte gratuit de 15 minutes, sans engagement.</p><p class="leading-8 text-ink/75">Cet échange permet d’aborder votre objectif, votre parcours en espagnol, vos disponibilités et votre éventuelle date d’examen. Je vous présente le fonctionnement des cours et réponds à vos questions.</p><p class="leading-8 text-ink/75">Cet entretien est facultatif. Vous pouvez aussi me contacter directement par e-mail, par téléphone ou sur WhatsApp pour poser vos questions ou convenir d’un premier cours.</p><p class="leading-8 text-ink/75">L’entretien découverte ne comprend pas d’évaluation détaillée de votre niveau.</p><a href={siteConfig.bookingUrl} class="btn-primary">Réserver mon entretien gratuit de 15 minutes — facultatif</a></div></div></section><section id="formules" class="scroll-mt-48 py-8"><div class="container-shell max-w-5xl"><div class="surface-card space-y-5 p-6 sm:p-10"><h2 class="text-3xl sm:text-4xl">Choisissez votre formule</h2><div class="grid gap-6 md:grid-cols-2"><div class="rounded-2xl border border-accent/25 bg-sand/40 p-6 space-y-5"><h3 class="pt-4 text-2xl">Cours à l’unité — 25 €</h3><p class="leading-8 text-ink/75">Une séance individuelle de 60 minutes en ligne.</p><p class="leading-8 text-ink/75">Pour découvrir ma façon de travailler, pratiquer ponctuellement ou approfondir une difficulté précise.</p><p class="leading-8 text-ink/75">Le contenu est adapté à vos besoins : expression orale, travail sur l’écrit, compréhension, grammaire ou préparation à une tâche du DELE B2.</p><a href="/contact" class="btn-primary">Me contacter pour un cours à l’unité</a></div><div class="rounded-2xl border border-accent/25 bg-sand/40 p-6 space-y-5"><h3 class="pt-4 text-2xl">Forfait de 5 cours — 125 €</h3><p class="leading-8 text-ink/75">Cinq séances individuelles de 60 minutes en ligne, soit 25 € par cours.</p><p class="leading-8 text-ink/75">Pour organiser un travail suivi autour de vos priorités, que vous souhaitiez consolider votre espagnol ou préparer le DELE B2.</p><h3 class="pt-4 text-2xl">Le forfait comprend :</h3><p class="leading-8 text-ink/75">Cinq cours personnalisés, adaptés à votre niveau et à votre objectif.</p><p class="leading-8 text-ink/75">Un point de départ intégré à la première séance, à partir d’activités ciblées pour préciser vos besoins.</p><p class="leading-8 text-ink/75">Des supports et des activités pour pratiquer entre les séances.</p><p class="leading-8 text-ink/75">Des corrections et des explications pendant les cours, notamment pour travailler vos productions écrites et orales.</p><p class="leading-8 text-ink/75">Un bilan en fin de forfait, pour identifier vos progrès et les prochaines étapes.</p><p class="leading-8 text-ink/75">La première séance est comprise dans les cinq cours, sans supplément. Vous commencez à travailler dès cette séance.</p><p class="leading-8 text-ink/75">Les corrections détaillées de productions écrites se font pendant les cours. Le forfait ne comprend pas de service de correction supplémentaire entre les séances.</p><a href="/contact" class="btn-primary">Me contacter pour le forfait de 5 cours</a></div></div></div></div></section><section class="scroll-mt-48 py-8"><div class="container-shell max-w-5xl"><div class="surface-card space-y-5 p-6 sm:p-10"><h2 class="text-3xl sm:text-4xl">Comment se déroulent les cours ?</h2><h3 class="pt-4 text-2xl">Avant de commencer</h3><p class="leading-8 text-ink/75">Nous échangeons par e-mail, par téléphone ou sur WhatsApp pour préciser vos besoins et répondre à vos questions. Vous choisissez ensuite votre formule et nous fixons ensemble le premier rendez-vous.</p><p class="leading-8 text-ink/75">Si vous le souhaitez, vous pouvez réserver un entretien découverte gratuit de 15 minutes, sans engagement. Cet entretien est facultatif et n’est pas nécessaire pour commencer les cours.</p><h3 class="pt-4 text-2xl">Pendant la première séance</h3><p class="leading-8 text-ink/75">Nous commençons le travail avec des activités adaptées à votre situation. Vous recevez de premiers conseils et nous précisons les priorités pour la suite.</p><h3 class="pt-4 text-2xl">Pour les rendez-vous suivants</h3><p class="leading-8 text-ink/75">Il n’est pas nécessaire de fixer les cinq cours à l’avance. À la fin de chaque séance, nous convenons ensemble de la date et de l’heure du prochain cours, selon nos disponibilités.</p><p class="leading-8 text-ink/75">Les cinq séances du forfait sont à utiliser dans les huit semaines suivant le premier cours.</p></div></div></section><section class="scroll-mt-48 py-8"><div class="container-shell max-w-5xl"><div class="surface-card space-y-5 p-6 sm:p-10"><h2 class="text-3xl sm:text-4xl">Paiement et organisation</h2><p class="leading-8 text-ink/75">Le paiement s’effectue par virement bancaire avant le cours :</p><p class="leading-8 text-ink/75">25 € avant chaque séance pour les cours à l’unité.</p><p class="leading-8 text-ink/75">125 € en une seule fois, avant la première séance, pour le forfait de cinq cours.</p><p class="leading-8 text-ink/75">Après confirmation du premier rendez-vous, je vous transmets les coordonnées bancaires et les informations nécessaires au règlement.</p><p class="leading-8 text-ink/75">Pour déplacer un cours, merci de me prévenir au moins 24 heures à l’avance. Nous convenons alors d’un nouveau créneau selon nos disponibilités.</p></div></div></section><section class="scroll-mt-48 py-8"><div class="container-shell max-w-5xl"><div class="surface-card space-y-5 p-6 sm:p-10"><h2 class="text-3xl sm:text-4xl">Parlons de votre projet</h2><p class="leading-8 text-ink/75">Vous souhaitez passer le DELE B2 ou prendre le temps de renforcer votre espagnol ? Contactez-moi pour poser vos questions ou convenir d’un premier cours.</p><a href="/contact" class="btn-primary">Me contacter</a><p class="leading-8 text-ink/75">Vous préférez réserver un moment pour en discuter ? Vous pouvez choisir un entretien découverte gratuit de 15 minutes, facultatif et sans engagement.</p><a href={siteConfig.bookingUrl} class="btn-primary">Réserver mon entretien gratuit de 15 minutes — facultatif</a></div></div></section><section class="section-gap"><div class="container-shell max-w-5xl"><h2 class="mb-8 text-3xl sm:text-4xl">Questions fr&#233;quentes</h2><FAQList items={faqs} /><p class="mt-6 leading-8"><a href="/cours/espagnol-certification" class="font-bold text-accent underline">Consultez aussi la FAQ de la pr&#233;paration DELE B2</a>.</p></div></section></BaseLayout>