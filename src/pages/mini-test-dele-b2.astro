---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/lib/site";
import { breadcrumbSchema } from "@/lib/schema";

const formUrl: string = siteConfig.miniTestFormUrl;
const embedUrl = formUrl ? new URL(formUrl) : null;
embedUrl?.searchParams.set("embedded", "true");
---

<BaseLayout
  title="Mini-test DELE B2 : faites le point sur votre espagnol"
  description="Faites le mini-test DELE B2 directement sur cette page pour commencer à situer votre niveau d’espagnol et orienter votre préparation."
  pathname={siteConfig.miniTestPath}
  schema={breadcrumbSchema([
    { name: "Accueil", url: `${siteConfig.siteUrl}/` },
    { name: "Mini-test DELE B2", url: `${siteConfig.siteUrl}${siteConfig.miniTestPath}` }
  ])}
>
  <section class="section-gap">
    <div class="container-shell max-w-4xl">
      <header class="space-y-5 pb-8 sm:pb-10">
        <p class="eyebrow">Faites le point sur votre espagnol</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl">Mini-test DELE B2</h1>
        <p class="max-w-3xl text-lg leading-8 text-ink/75">
          Vous préparez le DELE B2 et souhaitez savoir où vous en êtes ?
        </p>
        <p class="max-w-3xl text-lg leading-8 text-ink/75">
          Ce <strong>mini-test gratuit de 10 questions</strong> vous prendra seulement
          <strong>5 minutes</strong> et vous donnera une première indication sur votre préparation au DELE B2.
        </p>
        <p class="leading-7 text-ink/75">
          Installez-vous au calme et répondez sans dictionnaire ni outil de traduction,
          afin que vos réponses reflètent au mieux vos connaissances actuelles.
        </p>
        <p class="leading-7 text-ink">
          <strong>10 questions · 5 minutes · Résultat immédiat</strong>
        </p>
        <p class="leading-7 text-ink/75">
          Ce mini-test est un premier repère et ne remplace pas une évaluation complète de votre niveau.
        </p>
      </header>

      <section aria-labelledby="questionnaire-title" class="surface-card overflow-hidden">
        <div class="border-b border-line p-5 sm:p-8">
          <h2 id="questionnaire-title" class="text-2xl">À vous de jouer</h2>
          <p class="mt-2 leading-7 text-ink/75">Suivez les consignes du questionnaire et envoyez vos réponses à la fin.</p>
        </div>
        {embedUrl ? (
          <>
            <iframe
              src={embedUrl.toString()}
              title="Questionnaire du mini-test DELE B2"
              class="block h-[1200px] w-full border-0 sm:h-[1100px]"
            >
              Chargement du mini-test…
            </iframe>
            <p class="border-t border-line p-5 text-sm leading-6 text-ink/75 sm:px-8">
              Le formulaire ne s’affiche pas correctement ?{" "}
              <a href={formUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-accent underline underline-offset-4">
                Ouvrir le mini-test dans Google Forms (nouvel onglet)
              </a>.
            </p>
          </>
        ) : (
          <p class="p-5 leading-7 text-ink/75 sm:p-8">
            Le mini-test sera bientôt disponible sur cette page.
          </p>
        )}
      </section>

      <section aria-labelledby="apres-mini-test-title" class="surface-card mt-8 space-y-6 p-6 sm:p-8">
        <h2 id="apres-mini-test-title" class="text-3xl">Et après le mini-test ?</h2>
        <p class="leading-8 text-ink/75">
          Vous souhaitez consolider votre espagnol ou préparer les épreuves du DELE B2 ? Je vous accompagne avec des cours individuels adaptés à votre niveau et à votre rythme.
        </p>
        <p class="leading-8 text-ink/75">
          <strong>Vous pouvez commencer même si vous n’avez pas encore le niveau B2 ou de date d’examen prévue.</strong>
        </p>
        <div class="space-y-4">
          <h3 class="text-2xl">Cours individuels en ligne</h3>
          <p class="leading-8 text-ink/75">
            <strong class="text-ink">25 €</strong> le cours de 60 minutes<br />
            <strong class="text-ink">125 €</strong> le forfait de 5 cours de 60 minutes
          </p>
          <a href="/tarifs" class="btn-primary">Découvrir les cours et les tarifs</a>
        </div>
        <p class="leading-8 text-ink/75">
          Vous avez des questions ? <a href="/contact" class="font-bold text-accent underline underline-offset-4">Contactez-moi directement</a>.
        </p>
        <p class="leading-8 text-ink/75">
          Si vous préférez en discuter avant de commencer, vous pouvez aussi réserver un <a href={siteConfig.bookingUrl} class="font-bold text-accent underline underline-offset-4">entretien découverte gratuit de 15 minutes</a>, facultatif et sans engagement.
        </p>
      </section>
    </div>
  </section>
</BaseLayout>
