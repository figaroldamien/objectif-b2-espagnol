---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Message envoyé | Bilan gratuit" description="Votre message concernant le bilan gratuit a bien été envoyé." pathname="/merci/bilan-gratuit" noindex={true}>
  <section class="section-gap">
    <div class="container-shell max-w-3xl">
      <div class="surface-card p-8 sm:p-12">
        <p class="eyebrow">Bilan gratuit</p>
        <h1 class="mt-3 text-4xl">Merci pour votre message</h1>
        <p class="mt-5 text-lg leading-8 text-ink/75">Je vous répondrai par email sous 24 à 48h ouvrées pour échanger sur votre objectif et, si vous le souhaitez, convenir d’un rendez-vous.</p>
        <p class="mt-4 leading-7 text-ink/60">Ce message ne confirme pas de créneau de réservation.</p>
        <a href="/" class="btn-primary mt-8">Retour à l’accueil</a>
      </div>
    </div>
  </section>
</BaseLayout>
