---
import { siteConfig } from "@/lib/site";
---

<a
  href={siteConfig.whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="whatsapp-button fixed right-4 z-30 inline-flex min-h-12 items-center gap-2 rounded-full bg-[#128C45] px-5 py-3 text-sm font-bold text-white shadow-lg hover:bg-[#0d7037] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#128C45] sm:right-6"
  aria-label="M’écrire sur WhatsApp (nouvel onglet)"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6 shrink-0" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a9 9 0 0 1-13.4 7.9L3 21l1.6-4.6A9 9 0 1 1 21 11.5Z" />
    <path stroke-linecap="round" stroke-linejoin="round" d="m8.1 7.4 1.4-.4 1.2 2.5-1 1c.7 1.4 1.8 2.5 3.2 3.2l1-1 2.5 1.2-.4 1.4c-.2.7-.9 1.1-1.6 1-4-.6-7.1-3.7-7.7-7.7-.1-.7.3-1.4 1-1.6Z" />
  </svg>
  <span>M’écrire sur WhatsApp</span>
</a>

<style>
  .whatsapp-button {
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
  }
</style>
